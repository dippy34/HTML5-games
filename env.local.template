# Local Environment Variables Template
# Copy this file to .env.local and fill in your local values
# The .env.local file is ignored by git and won't be shared

# Server Configuration
PORT=3000

# Google Forms Integration
# Option 1: Google Apps Script (Recommended)
# Get this URL by deploying google-forms-appscript.js as a web app
GOOGLE_FORMS_APPSCRIPT_URL=

# Option 2: Google Sheets API (Alternative)
# Get this from Google Cloud Console after enabling Sheets API
GOOGLE_SHEETS_API_KEY=

# Admin Configuration (optional - uses admin-accounts.js by default)
# ADMIN_PASSWORD_HASH=

# Google Analytics 4 (GA4)
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# Google Analytics 4 Data API (for admin dashboard stats)
# To enable realtime and historical data in admin panel:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project
# 3. Enable "Google Analytics Data API"
# 4. Create a Service Account and download JSON key
# 5. Grant the service account access to your GA4 property
# 6. Get your Property ID from GA4 Admin (format: properties/123456789)
# 7. Use OAuth 2.0 or Service Account token

# Required
GA4_PROPERTY_ID=

# Option 1: OAuth 2.0 Access Token (expires after ~1 hour, need to refresh)
# Get from: https://developers.google.com/oauthplayground/
GA4_ACCESS_TOKEN=

# Option 2: Service Account (Recommended - doesn't expire!)
# Copy the entire JSON key file content here (as a single line JSON string)
# OR base64 encode it: cat service-account-key.json | base64
GA4_SERVICE_ACCOUNT_KEY=

